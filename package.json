{
  "name": "@occluze/tether",
  "version": "0.3.6",
  "description": "Free, open-source alternative to Smootify and Storesynk (Shopyflow): Shopify products, cart and subscriptions in Webflow with HTML attributes. Optional Shopify to Webflow CMS sync.",
  "type": "module",
  "main": "dist/tether.esm.js",
  "module": "dist/tether.esm.js",
  "exports": {
    ".": "./dist/tether.esm.js",
    "./presets/barba": "./dist/presets/barba.esm.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "node --test test/*.test.js server/test/*.test.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0"
  },
  "license": "MIT",
  "author": "Ravi Klaassens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravi-klaassens/tether.git"
  },
  "homepage": "https://github.com/ravi-klaassens/tether#readme",
  "bugs": {
    "url": "https://github.com/ravi-klaassens/tether/issues"
  },
  "keywords": [
    "cart",
    "ecommerce",
    "headless",
    "headless-shopify",
    "selling-plans",
    "shopify",
    "shopify-subscriptions",
    "shopyflow-alternative",
    "smootify-alternative",
    "storefront-api",
    "storesynk-alternative",
    "subscriptions",
    "webflow",
    "webflow-cms",
    "webflow-ecommerce",
    "webflow-shopify"
  ],
  "publishConfig": {
    "access": "public"
  }
}
