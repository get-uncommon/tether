{
  "name": "@occluze/tether",
  "version": "0.4.0",
  "description": "Free, open-source alternative to Smootify and Storesynk (Shopyflow): Shopify products, cart and subscriptions in Webflow with HTML attributes. Optional Shopify to Webflow CMS sync.",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./presets/barba": {
      "types": "./types/barba.d.ts",
      "default": "./dist/presets/barba.esm.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "types/index.d.ts",
    "types/barba.d.ts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "node --test test/*.test.js server/test/*.test.js && npm run test:types",
    "smoke": "node scripts/smoke.mjs",
    "pretest": "node scripts/build.mjs",
    "presmoke": "node scripts/build.mjs",
    "test:types": "tsc -p types/tsconfig.json",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": {
    "name": "Ravi Klaassens",
    "url": "https://occluze.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravi-klaassens/tether.git"
  },
  "homepage": "https://github.com/ravi-klaassens/tether#readme",
  "bugs": {
    "url": "https://github.com/ravi-klaassens/tether/issues"
  },
  "keywords": [
    "cart",
    "ecommerce",
    "headless",
    "headless-shopify",
    "selling-plans",
    "shopify",
    "shopify-subscriptions",
    "shopyflow-alternative",
    "smootify-alternative",
    "storefront-api",
    "storesynk-alternative",
    "subscriptions",
    "webflow",
    "webflow-cms",
    "webflow-ecommerce",
    "webflow-shopify"
  ],
  "publishConfig": {
    "access": "public"
  },
  "types": "types/index.d.ts"
}
