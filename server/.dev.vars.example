# What the Deploy to Cloudflare button asks for. Descriptions: package.json -> cloudflare.bindings.
# Optional settings (SHOPIFY_ADMIN_TOKEN, SHOPIFY_WEBHOOK_SECRET, FIELD_MAP, WEBFLOW_OWNED,
# MAX_SUBREQUESTS) can be added later as secrets in the Worker's settings: see README.
SHOPIFY_DOMAIN=
WEBFLOW_COLLECTION_ID=
WEBFLOW_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SYNC_SECRET=
