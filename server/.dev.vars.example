# Values for the Deploy to Cloudflare button (and `npx wrangler dev`: copy to .dev.vars).
# Leave a value empty when you don't use it. Descriptions: package.json -> cloudflare.bindings.

# Required
SHOPIFY_DOMAIN=
WEBFLOW_COLLECTION_ID=
WEBFLOW_TOKEN=

# Shopify access: a Dev Dashboard app (client id + secret), or SHOPIFY_ADMIN_TOKEN for an existing custom app
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=

# Optional
SHOPIFY_WEBHOOK_SECRET=
SYNC_SECRET=
FIELD_MAP=
