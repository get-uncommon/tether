{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/server.ts",
    "src/astro.ts",
    "src/presets/barba.ts",
    "src/parts/*.ts",
    "src/lazy-iife.ts",
    "server/src/entry.{js,ts}",
    "server/src/index.ts",
    "server/bin/tether-sync.{js,ts}",
    "server/scripts/*.{mjs,ts}",
    "scripts/*.ts",
    "test/**/*.js",
    "server/test/**/*.js",
    "e2e/*.{js,mjs}",
    "types/check.ts"
  ],
  "project": [
    "src/**/*.ts",
    "server/src/**/*.{js,ts}",
    "server/bin/*.{js,ts}",
    "server/scripts/*.{mjs,ts}",
    "scripts/*.ts"
  ],
  "ignoreBinaries": ["tsc"],
  "rules": {
    "duplicates": "off"
  }
}
