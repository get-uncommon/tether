{
  "$schema": "https://json.schemastore.org/tsconfig",
  // One program per runtime, so each file sees only the globals of where it runs (`npm run typecheck` builds them all;
  // editors and ESLint find a file's program through these references).
  "files": [],
  "references": [
    { "path": "./tsconfig.browser.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.worker.json" },
    { "path": "./tsconfig.worker-node.json" },
    { "path": "./tsconfig.test.json" },
    { "path": "./tsconfig.e2e.json" }
  ]
}
